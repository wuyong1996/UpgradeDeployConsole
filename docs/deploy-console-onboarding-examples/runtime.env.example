# SERVER-SIDE EXAMPLE ONLY. Merge with the existing runtime.env; do not overwrite it.
# Replace "project" with the real slug and use the configuration keys your app reads.
# Fill secrets only on the server. Do not commit the completed file.
# systemd EnvironmentFile syntax: KEY=value, no "export", no shell substitutions.
ASPNETCORE_ENVIRONMENT=Production
DataProtection__KeysPath=/var/lib/deploy-projects/project/keys

# Example only: AppDb is not a universal connection-string name.
# ConnectionStrings__AppDb="Server=127.0.0.1;Port=3306;Database=PROJECT_DB;User=PROJECT_USER;Password=SERVER_ONLY_VALUE"
# Example only: pre-create writable folders owned by this app's runtime user.
# Storage__RootPath=/var/lib/deploy-projects/project/uploads

# Do not set ASPNETCORE_URLS here: the console manages the backend port.
# These runtime settings are NOT frontend build environment variables.
